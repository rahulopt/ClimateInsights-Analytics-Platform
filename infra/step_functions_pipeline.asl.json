{
  "Comment": "ClimateInsights Phase 2 — Monthly Climate Analytics Pipeline. Triggered by EventBridge on the 2nd of each month. Launches a transient EMR cluster, runs Silver append + Gold refresh, notifies stakeholders, then terminates the cluster.",

  "StartAt": "ValidateInput",

  "States": {

    "ValidateInput": {
      "Type": "Pass",
      "Comment": "Ensure year/month are present in the execution input. EventBridge passes them as $.year and $.month.",
      "Parameters": {
        "year.$":  "$.year",
        "month.$": "$.month"
      },
      "ResultPath": "$.params",
      "Next": "CreateEMRCluster"
    },

    "CreateEMRCluster": {
      "Type": "Task",
      "Comment": "Launch a transient EMR 6.15.0 cluster with spot Core nodes. KeepJobFlowAliveWhenNoSteps=false ensures it terminates after all steps finish.",
      "Resource": "arn:aws:states:::elasticmapreduce:createCluster.sync",
      "Parameters": {
        "Name.$":         "States.Format('climateinsights-phase2-{}-{:02d}', $.params.year, $.params.month)",
        "ReleaseLabel":   "emr-6.15.0",
        "Applications": [
          { "Name": "Spark"  },
          { "Name": "Hadoop" }
        ],
        "Instances": {
          "InstanceGroups": [
            {
              "Name":          "Master",
              "InstanceRole":  "MASTER",
              "InstanceType":  "m5.xlarge",
              "InstanceCount": 1,
              "Market":        "ON_DEMAND"
            },
            {
              "Name":          "Core",
              "InstanceRole":  "CORE",
              "InstanceType":  "m5.xlarge",
              "InstanceCount": 2,
              "Market":        "SPOT",
              "BidPrice":      "0.10"
            }
          ],
          "KeepJobFlowAliveWhenNoSteps": false,
          "TerminationProtected":        false
        },
        "BootstrapActions": [
          {
            "Name": "install-dependencies",
            "ScriptBootstrapAction": {
              "Path.$": "States.Format('s3://{}/scripts/bootstrap_emr.sh', $.bucket)"
            }
          }
        ],
        "Configurations": [
          {
            "Classification": "spark-env",
            "Configurations": [
              {
                "Classification": "export",
                "Properties": {
                  "PYSPARK_PYTHON": "/usr/bin/python3"
                }
              }
            ]
          },
          {
            "Classification": "spark",
            "Properties": {
              "maximizeResourceAllocation": "true"
            }
          }
        ],
        "JobFlowRole":    "EMR_EC2_DefaultRole",
        "ServiceRole":    "EMR_DefaultRole",
        "VisibleToAllUsers": true,
        "AutoTerminationPolicy": {
          "IdleTimeout": 1800
        },
        "Tags": [
          { "Key": "Project",     "Value": "ClimateInsights" },
          { "Key": "Phase",       "Value": "2-monthly"        },
          { "Key": "ManagedBy",   "Value": "step-functions"   }
        ],
        "LogUri.$": "States.Format('s3://{}/logs/emr/phase2/', $.bucket)"
      },
      "ResultPath":   "$.cluster",
      "Next":         "RunSilverAppend",
      "Retry": [
        {
          "ErrorEquals":   ["States.TaskFailed"],
          "IntervalSeconds": 60,
          "MaxAttempts":     2,
          "BackoffRate":     2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath":  "$.error",
          "Next":        "NotifyFailure"
        }
      ]
    },

    "RunSilverAppend": {
      "Type": "Task",
      "Comment": "Submit the monthly Silver append Spark step to the running cluster.",
      "Resource": "arn:aws:states:::elasticmapreduce:addStep.sync",
      "Parameters": {
        "ClusterId.$": "$.cluster.ClusterId",
        "Step": {
          "Name":             "monthly-silver-append",
          "ActionOnFailure":  "TERMINATE_CLUSTER",
          "HadoopJarStep": {
            "Jar": "command-runner.jar",
            "Args.$": "States.Array(\n              'spark-submit',\n              '--deploy-mode', 'cluster',\n              '--conf', 'spark.sql.shuffle.partitions=100',\n              '--conf', 'spark.sql.adaptive.enabled=true',\n              States.Format('s3://{}/scripts/phase2/monthly_silver_append.py', $.bucket),\n              '--source_path', States.Format('s3://{}/landing/{}/{:02d}/', $.bucket, $.params.year, $.params.month),\n              '--silver_path', States.Format('s3://{}/silver/noaa_parquet/', $.bucket),\n              '--year',  States.JsonToString($.params.year),\n              '--month', States.JsonToString($.params.month)\n            )"
          }
        }
      },
      "ResultPath": "$.silverStep",
      "Next":       "RunGoldRefresh",
      "Retry": [
        {
          "ErrorEquals":   ["States.TaskFailed"],
          "IntervalSeconds": 120,
          "MaxAttempts":     2,
          "BackoffRate":     2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath":  "$.error",
          "Next":        "TerminateClusterOnFailure"
        }
      ]
    },

    "RunGoldRefresh": {
      "Type": "Task",
      "Comment": "Submit the Gold full-refresh step after Silver append succeeds.",
      "Resource": "arn:aws:states:::elasticmapreduce:addStep.sync",
      "Parameters": {
        "ClusterId.$": "$.cluster.ClusterId",
        "Step": {
          "Name":            "gold-full-refresh",
          "ActionOnFailure": "TERMINATE_CLUSTER",
          "HadoopJarStep": {
            "Jar": "command-runner.jar",
            "Args.$": "States.Array(\n              'spark-submit',\n              '--deploy-mode', 'cluster',\n              '--conf', 'spark.sql.shuffle.partitions=100',\n              States.Format('s3://{}/scripts/phase2/gold_full_refresh.py', $.bucket),\n              '--silver_path', States.Format('s3://{}/silver/noaa_parquet/', $.bucket),\n              '--gold_path',   States.Format('s3://{}/gold/', $.bucket),\n              '--year',  States.JsonToString($.params.year),\n              '--month', States.JsonToString($.params.month)\n            )"
          }
        }
      },
      "ResultPath": "$.goldStep",
      "Next":       "NotifySuccess",
      "Retry": [
        {
          "ErrorEquals":   ["States.TaskFailed"],
          "IntervalSeconds": 120,
          "MaxAttempts":     2,
          "BackoffRate":     2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath":  "$.error",
          "Next":        "TerminateClusterOnFailure"
        }
      ]
    },

    "NotifySuccess": {
      "Type": "Task",
      "Comment": "Publish success notification to SNS. Stakeholders receive email/SMS.",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn.$": "$.snsTopic",
        "Subject.$":  "States.Format('[ClimateInsights] ✅ {} Climate Insights Ready', $.params.year)",
        "Message.$":  "States.Format('Monthly climate analytics pipeline completed successfully.\\n\\nYear:  {}\\nMonth: {:02d}\\n\\nNew data is available in:\\n  Silver: s3://{}/silver/noaa_parquet/year={}/month={}/\\n  Gold tables:\\n    - annual_temperature_trends\\n    - monthly_precipitation\\n    - station_coverage\\n\\nQuery via Athena or explore in QuickSight.\\n\\nPipeline ID: {}', $.params.year, $.params.month, $.bucket, $.params.year, $.params.month, $$.Execution.Name)"
      },
      "ResultPath": "$.notification",
      "Next":       "PipelineSucceeded"
    },

    "PipelineSucceeded": {
      "Type":  "Succeed",
      "Comment": "Terminal success state."
    },

    "TerminateClusterOnFailure": {
      "Type": "Task",
      "Comment": "Ensure cluster is terminated even on step failure (belt-and-suspenders alongside ActionOnFailure=TERMINATE_CLUSTER).",
      "Resource": "arn:aws:states:::elasticmapreduce:terminateCluster",
      "Parameters": {
        "ClusterId.$": "$.cluster.ClusterId"
      },
      "ResultPath": "$.termination",
      "Next":       "NotifyFailure"
    },

    "NotifyFailure": {
      "Type": "Task",
      "Comment": "Publish failure alert to SNS so the team can investigate.",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn.$": "$.snsTopic",
        "Subject.$":  "States.Format('[ClimateInsights] ❌ Pipeline FAILED — {}/{:02d}', $.params.year, $.params.month)",
        "Message.$":  "States.Format('Monthly climate analytics pipeline FAILED.\\n\\nYear:  {}\\nMonth: {:02d}\\nPipeline ID: {}\\n\\nError details:\\n{}\\n\\nCheck EMR logs at:\\n  s3://{}/logs/emr/phase2/\\n\\nPlease investigate and re-trigger if necessary.', $.params.year, $.params.month, $$.Execution.Name, States.JsonToString($.error), $.bucket)"
      },
      "ResultPath": "$.failureNotification",
      "Next":       "PipelineFailed"
    },

    "PipelineFailed": {
      "Type":  "Fail",
      "Error": "PipelineError",
      "Cause": "Monthly pipeline failed — see SNS notification for details."
    }

  }
}
